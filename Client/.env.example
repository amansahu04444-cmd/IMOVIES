# ==============================================================================
# IMovies Frontend Environment Configuration (Client/.env.example)
# ==============================================================================

# API Base URL:
# - Local Development: Leave as '/api' so Vite dev server proxies requests to localhost:5000
# - Render Production: Set to your deployed Render backend web service URL.
#   Example: VITE_API_URL=https://imovies-server.onrender.com/api
#   Note: The service layer automatically normalizes trailing slashes and ensures /api prefix.
VITE_API_URL=/api

# Optional: Set to 'true' ONLY in local development to display demo login shortcut buttons.
# In production builds, demo login shortcuts are disabled by default.
VITE_ENABLE_DEV_DEMO_LOGINS=false
