{
  "buildCommand": "npm --prefix Client install && npm --prefix Client run build",
  "outputDirectory": "Client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://imovies-bi04.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
