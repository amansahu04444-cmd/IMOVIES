# ==============================================================================
# IMovies Backend Environment Configuration (Server/.env.example)
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Database Connection:
# - Local Development: mongodb://127.0.0.1:27017/imovies
# - Render Production: MUST use a remote MongoDB Atlas cluster connection string.
#   Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/imovies?retryWrites=true&w=majority
#   Important: Never use localhost in production. Configure Atlas Network Access (0.0.0.0/0 for Render).
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JSON Web Token Secret
# - Use a strong, cryptographically secure 64-character random string in production
JWT_SECRET=your_jwt_secret_key_here

# Frontend CORS Origin:
# - Local Development: http://localhost:5173
# - Render Production: Deployed frontend URL (comma-separated if multiple origins).
#   Example: CLIENT_URL=https://imovies-client.onrender.com,http://localhost:5173
#   Note: Trailing slashes are automatically stripped by the CORS middleware.
CLIENT_URL=http://localhost:5173

# Admin Provisioning Configuration (Used by npm run setup:admin and seed)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_min_6_chars
